# ── Swipe Billing auth ──────────────────────────────────────────────────
# The app uses Swipe's INTERNAL API (the same one the Swipe web app calls),
# authenticated with the session token pp-billing keeps in Upstash Redis
# under `swipe:token` (refreshed via pp-billing's /settings page).
# Copy these Upstash REST credentials from pp-billing/.env.local:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional fallback for local runs without Redis — a Swipe session token:
SWIPE_API_TOKEN=

# ── Ops monitor ─────────────────────────────────────────────────────────
# Password for /ops (staff session monitor: check-in validation, timers,
# check-out). The gate is disabled-by-default: with no password set, /ops
# only ever shows the login screen.
OPS_PASSWORD=

# Owner tier. Typed into the same login box as OPS_PASSWORD; it opens
# everything the counter's password does, plus the cash ledger's money views
# (the Swipe tally, the variance, and setting a month's opening balance).
# Leave blank and there is no admin tier — the ledger stays entry-only.
ADMIN_PASSWORD=

# ── Payment toggle ──────────────────────────────────────────────────────
# "false" = online payment off: bookings create the Swipe invoice (unpaid)
# and the customer pays at the counter.
# "true" = collect via Razorpay, then record it in Swipe.
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# ── Discount codes for customers (see docs/discounts.md) ────────────────
# "true" = the booking form shows a discount-code box and /api/checkout
# honours a typed code. Anything else (including unset) = self-checkout
# behaves as if codes don't exist.
# NOT a switch for the counter: staff can always discount an invoice from
# /ops, and manage codes on /ops/discounts, whatever this is set to.
NEXT_PUBLIC_DISCOUNT_CODES_ENABLED=false

# ── Razorpay (our own account — see src/lib/razorpay.ts) ────────────────
# Orders are created and signatures verified with these keys; the payment is
# then recorded on the Swipe invoice. rzp_test_ keys run the identical flow
# in Razorpay test mode (no real money) and are refused on production
# deployments. Missing keys = checkout degrades to pay-at-counter.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret for the dashboard webhook → /api/payment/webhook (events:
# payment.captured, order.paid). The webhook marks the invoice paid even if
# the customer's browser dies before confirming. Unset = webhook rejects all.
RAZORPAY_WEBHOOK_SECRET=

# ── Memberships (/members) ──────────────────────────────────────────────
# Durable store for memberships & visits — Postgres connection string.
# On Vercel: install Neon from the Marketplace (Storage tab) and this is set
# automatically; locally run `vercel env pull` or paste the pooled URL here.
# HEADS UP: pulling or pasting the deployed URL points local dev at the SAME
# database prod writes to. Only `invoices` records which environment wrote a
# row; customers, memberships and visits don't, so local rows are then
# indistinguishable from the counter's.
DATABASE_URL=

# Optional Google Sheets mirror: every membership/visit row is also appended
# to a spreadsheet for easy viewing. Create a Google Cloud service account
# with the Sheets API enabled, share the sheet with its email as Editor, then
# run `npx tsx scripts/setup-sheets.ts` once. See docs/memberships.md.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
