# ── Swipe Billing auth ──────────────────────────────────────────────────
# The app uses Swipe's INTERNAL API (the same one the Swipe web app calls),
# authenticated with the session token pp-billing keeps in Upstash Redis
# under `swipe:token` (refreshed via pp-billing's /settings page).
# Copy these Upstash REST credentials from pp-billing/.env.local:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional fallback for local runs without Redis — a Swipe session token:
SWIPE_API_TOKEN=

# ── Ops monitor ─────────────────────────────────────────────────────────
# Password for /ops (staff session monitor: check-in validation, timers,
# check-out). The gate is disabled-by-default: with no password set, /ops
# only ever shows the login screen.
OPS_PASSWORD=

# ── Payment toggle ──────────────────────────────────────────────────────
# "false" = online payment off: bookings create the Swipe invoice (unpaid)
# and the customer pays at the counter (current phase — Razorpay pending).
# "true" = collect payment, then record it in Swipe (v3/payments/create_payment).
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# ── Memberships (/members) ──────────────────────────────────────────────
# Durable store for memberships & visits — Postgres connection string.
# On Vercel: install Neon from the Marketplace (Storage tab) and this is set
# automatically; locally run `vercel env pull` or paste the pooled URL here.
DATABASE_URL=

# Optional Google Sheets mirror: every membership/visit row is also appended
# to a spreadsheet for easy viewing. Create a Google Cloud service account
# with the Sheets API enabled, share the sheet with its email as Editor, then
# run `npx tsx scripts/setup-sheets.ts` once. See docs/memberships.md.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
